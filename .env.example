# ===========================================
# Event Sync Configuration
# ===========================================
# These environment variables are used by the cron job
# that automatically fetches events from Luma and Meetup.
# Set them in your Vercel project settings.

# Luma API Key
# Required for fetching events from your Luma calendar.
# Requires an active Luma Plus subscription.
# Get it from: lu.ma/home/settings/integrations (Settings → Developer)
LUMA_API_KEY=

# Meetup OAuth Token
# Required for searching events on Meetup.
# Get it from: https://www.meetup.com/api/authentication/
# You need to create an OAuth consumer and obtain a token.
MEETUP_API_KEY=

# Cron Secret (recommended for production)
# Secures the /api/cron/sync-events endpoint.
# Must be at least 16 characters.
# Set this in Vercel project settings under Environment Variables.
CRON_SECRET=
